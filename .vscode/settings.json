{
  "liveServer.settings.port": 8765,
  "liveServer.settings.host": "127.0.0.1",
  "liveServer.settings.root": "/",
  "liveServer.settings.showOnStatusbar": true,
  "liveServer.settings.wait": 200,
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "**/*.scss",
    "**/*.sass",
    "**/*.ts",
    "node_modules/**",
    "venv/**",
    ".venv/**",
    "tmp/**",
    "server/data/**",
    "server/*.log",
    "server/**/*.log"
  ]
}
